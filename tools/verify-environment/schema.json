{
  "$comment": "environment.json v1.0 schema（M0-T1）。dotted path 定位字段；type ∈ string|number|bool|object|array；required 缺失即 FAIL；nullable 允许 null；volatile 的字段在幂等性比对中跳过。",
  "schema_version": "1.0",
  "fields": {
    "schema_version": { "type": "string", "required": true },
    "tool": { "type": "object", "required": true },
    "tool.name": { "type": "string", "required": true },
    "tool.version": { "type": "string", "required": true },
    "tool.engine": { "type": "string", "required": true },
    "run_id": { "type": "string", "required": true },
    "generated_at": { "type": "string", "required": true, "volatile": true },

    "machine": { "type": "object", "required": true },
    "machine.hostname": { "type": "string", "required": true },
    "machine.os": { "type": "object", "required": true },
    "machine.os.caption": { "type": "string", "required": true, "nullable": true },
    "machine.os.version": { "type": "string", "required": true, "nullable": true },
    "machine.os.build": { "type": "string", "required": true, "nullable": true },
    "machine.os.ubr": { "type": "number", "required": true, "nullable": true },
    "machine.os.display_version": { "type": "string", "required": true, "nullable": true },
    "machine.os.edition": { "type": "string", "required": true, "nullable": true },
    "machine.os.edition_id": { "type": "string", "required": true, "nullable": true },
    "machine.os.meets_22000": { "type": "bool", "required": true, "nullable": true, "desc": "MFCreateVirtualCamera 门槛（基线 §2.1）" },
    "machine.cpu": { "type": "object", "required": true },
    "machine.cpu.name": { "type": "string", "required": true, "nullable": true },
    "machine.cpu.cores": { "type": "number", "required": true, "nullable": true },
    "machine.cpu.threads": { "type": "number", "required": true, "nullable": true },
    "machine.gpu": { "type": "array", "required": true },
    "machine.ram_gb": { "type": "object", "required": true },
    "machine.ram_gb.total": { "type": "number", "required": true, "nullable": true },
    "machine.ram_gb.free": { "type": "number", "required": true, "nullable": true, "volatile": true },
    "machine.disk": { "type": "array", "required": true },

    "toolchain": { "type": "object", "required": true },
    "toolchain.git": { "type": "string", "required": true, "nullable": true },
    "toolchain.python": { "type": "string", "required": true, "nullable": true },
    "toolchain.cmake": { "type": "string", "required": true, "nullable": true },
    "toolchain.rust": { "type": "object", "required": true },
    "toolchain.rust.rustc": { "type": "string", "required": true, "nullable": true },
    "toolchain.rust.cargo": { "type": "string", "required": true, "nullable": true },
    "toolchain.rust.rustup_toolchain": { "type": "string", "required": true, "nullable": true },
    "toolchain.rust.default_host": { "type": "string", "required": true, "nullable": true },
    "toolchain.visual_studio.instances": { "type": "array", "required": true, "desc": "每实例含 msvc_toolsets 与 cl_instances（cl.exe 真实执行的 banner）" },
    "toolchain.windows_sdks": { "type": "array", "required": true },
    "toolchain.wdk": { "type": "object", "required": true },
    "toolchain.wdk.installed": { "type": "bool", "required": true, "nullable": true },
    "toolchain.gstreamer": { "type": "object", "required": true },
    "toolchain.gstreamer.installed": { "type": "bool", "required": true, "nullable": true },
    "toolchain.gstreamer.variant": { "type": "string", "required": false, "nullable": true, "desc": "必须为 msvc（MinGW 版是 M1 阻塞隐患，基线 R-07/M0-T9）" },
    "toolchain.gstreamer.version_output": { "type": "string", "required": false, "nullable": true },
    "toolchain.gstreamer.root": { "type": "string", "required": false, "nullable": true },
    "toolchain.gstreamer.gst_launch_path": { "type": "string", "required": false, "nullable": true },

    "devices": { "type": "object", "required": true },
    "devices.cameras": { "type": "array", "required": true },
    "devices.audio": { "type": "array", "required": true },
    "devices.privacy_hint": { "type": "object", "required": true },

    "security_software": { "type": "object", "required": true },
    "security_software.av_products": { "type": "array", "required": true },
    "security_software.firewall": { "type": "array", "required": true },
    "security_software.adapters_up": { "type": "array", "required": true },

    "accounts": { "type": "object", "required": true },
    "accounts.local_users_enabled": { "type": "array", "required": true },
    "accounts.current_shell_is_admin": { "type": "bool", "required": true, "nullable": true },

    "unconfirmed_facts": { "type": "array", "required": true, "desc": "无法从本机探测的事实，显式 unconfirmed" },
    "probes_failed": { "type": "array", "required": true, "desc": "失败的探针（名 + 原因），绝不为空数组以外的静默失败" }
  }
}
